{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-KB front-matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "domain",
    "scope",
    "status",
    "confidence",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kb-\\d{8}-[0-9a-f]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "decision",
        "howto",
        "pitfall",
        "plan",
        "rca",
        "reference",
        "retrospective",
        "spec"
      ]
    },
    "domain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "algorithm",
          "backend",
          "build",
          "database",
          "devops",
          "frontend",
          "process",
          "security",
          "testing",
          "tooling"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "project",
        "stack",
        "universal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated",
        "superseded"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "verified",
        "probable",
        "speculative"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "dedup_key": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}